# Copy to server/.env and fill in. server/.env is gitignored; never commit it.
# Without a key the phone listens and speaks with the system voice (ready.tts/stt = "device").
ELEVENLABS_API_KEY=
# "Chi" (young female, northern accent)
ELEVENLABS_VOICE_ID=5yEPTrA0uAhZsBEhHjfi
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Leave blank to keep speech recognition on the phone. Example: scribe_v1
ELEVENLABS_STT_MODEL=
PORT=8787
