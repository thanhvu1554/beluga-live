# Copy to server/.env and fill in. server/.env is gitignored; never commit it.
# Without any key the phone listens and speaks with the system voice (ready.tts/stt = "device").

# Provider choice: auto | genvoice | elevenlabs | device. auto = GenVoice if its key is set,
# else ElevenLabs if its key is set, else device. Applies separately to speech out (TTS) and in (STT).
TTS_PROVIDER=auto
STT_PROVIDER=auto

# GenVoice (preferred): https://genvoice.pro
GENVOICE_API_KEY=
# "Chi" (young female, northern accent)
GENVOICE_VOICE_ID=5yEPTrA0uAhZsBEhHjfi
GENVOICE_TTS_MODEL=eleven_flash_v2_5

# ElevenLabs direct (fallback provider)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=5yEPTrA0uAhZsBEhHjfi
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Default scribe_v1 when blank
ELEVENLABS_STT_MODEL=

PORT=8787

# Optional tuning (milliseconds). Per-sentence TTS deadline = BASE + PER_CHAR * characters;
# STT deadline = BASE + PER_SEC * seconds of audio. Past it, the phone speaks with the system voice.
# BELUGA_TTS_BASE_MS=8000
# BELUGA_TTS_PER_CHAR_MS=60
# BELUGA_STT_BASE_MS=8000
# BELUGA_STT_PER_SEC_MS=1500
# Claude reasoning effort for every model (default: sonnet=medium, opus=low, haiku=none)
# BELUGA_EFFORT=

# Other model providers (PROTOCOL section 10) and the utility model (STT fix, titles, summaries, greeting).
# A model whose key is missing is not offered to the phone. Catalogue: models.json (see models.example.json).
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# BELUGA_UTIL_MODEL_DEEPSEEK=deepseek-flash
# BELUGA_UTIL_MODEL_OPENROUTER=deepseek/deepseek-v4.1-flash
# Compact a session when one turn's input exceeds this many tokens.
# BELUGA_COMPACT_TOKENS=120000
# Use the utility model in --mock too.
# BELUGA_UTIL_IN_MOCK=1

# Off-VPS backup to Cloudflare R2 (PROTOCOL section 20). Off when any of the four keys is missing.
# Archive of server/data (minus mcp/), tutor/memory, voices.json, models.json: nightly at 03:00 and
# 2 minutes after the last data change (at most once per 10 minutes); skipped when unchanged.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: any other S3-compatible endpoint instead of https://<account>.r2.cloudflarestorage.com
# R2_ENDPOINT=
# Optional: encrypt with AES-256-GCM (key from PBKDF2). Without it a restore is impossible: keep a copy elsewhere.
# BACKUP_PASSPHRASE=
# BACKUP_KEEP_DAYS=14
