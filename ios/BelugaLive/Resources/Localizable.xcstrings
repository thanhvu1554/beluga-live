    "diag.footer": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi ứng dụng bị văng ra màn hình chính, lần mở sau nó ghi lại lý do và những việc ngay trước đó. Gửi báo lỗi cho nhà phát triển để sửa."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the app gets thrown out to the Home Screen, the next launch records why and what happened just before. Send the report to the developer."
          }
        }
      }
